{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Rastro de datos: observabilidad y retención",
    "output": "docs/diagramas/rastro-datos.html",
    "viewBox": [
      1080,
      540
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "origenes",
        "label": "Orígenes del disparo",
        "focus": [
          "http_call",
          "cron_evt",
          "engine_run"
        ],
        "note": "HTTP, cron, eventos y manual dejan trigger_data rastreable en la ejecución."
      },
      {
        "id": "persistencia",
        "label": "Persistencia enmascarada",
        "focus": [
          "engine_run",
          "mask",
          "steps_row"
        ],
        "note": "El mask se aplica antes de dormir: el valor original no existe en ninguna tabla."
      },
      {
        "id": "consumos",
        "label": "Consumos del rastro",
        "focus": [
          "steps_row",
          "consola_trace",
          "replay"
        ],
        "note": "La consola, el polling, el replay y el webhook firman leen del mismo almacén."
      }
    ]
  },
  "stages": [
    {
      "label": "Disparo"
    },
    {
      "label": "Ejecución"
    },
    {
      "label": "Persistencia"
    },
    {
      "label": "Consumo"
    }
  ],
  "nodes": [
    {
      "id": "http_call",
