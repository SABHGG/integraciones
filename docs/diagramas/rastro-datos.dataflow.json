      "sublabel": "miniatura por fila",
      "stage": 3,
      "row": 2,
      "tag": "solo lectura",
      "width": 130
    },
    {
      "id": "replay",
      "type": "backend",
      "label": "Replay",
      "sublabel": "versión congelada",
      "stage": 3,
      "row": 0,
      "tag": "nueva ejecución",
      "width": 130
    }
  ],
  "flows": [
    {
      "id": "http-trigger",
      "from": "http_call",
      "to": "engine_run",
