      "label": "POST /x/{slug}",
      "sublabel": "sync · async",
      "stage": 0,
      "row": 0,
      "tag": "HTTP",
      "width": 130
    },
    {
      "id": "cron_evt",
      "type": "cloud",
      "label": "Cron · eventos",
      "sublabel": "scheduler · fan-out",
      "stage": 0,
      "row": 1,
      "tag": "triggers",
      "width": 130
    },
    {
      "id": "engine_run",
      "type": "backend",
      "label": "Engine",
      "sublabel": "cadena · fail-fast",
      "stage": 1,
      "row": 1,
      "tag": "isolate fresco",
      "width": 130
    },
    {
      "id": "mask",
      "type": "security",
      "label": "Mask",
      "sublabel": "congelado por versión",
      "stage": 1,
      "row": 2,
      "tag": "irreversible",
      "width": 130
    },
    {
      "id": "exec_row",
      "type": "database",
      "label": "executions",
      "sublabel": "estado · trigger_data",
      "stage": 2,
      "row": 0,
      "tag": "365 d",
      "width": 130
    },
    {
      "id": "steps_row",
      "type": "database",
      "label": "execution_steps",
      "sublabel": "IO + duración",
      "stage": 2,
      "row": 2,
