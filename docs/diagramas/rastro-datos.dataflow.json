      "classification": "disparo",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "cron-trigger",
      "from": "cron_evt",
      "to": "engine_run",
      "label": "topic · run_at",
      "classification": "disparo",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "left",
      "labelDx": -30,
      "labelAt": [
        178,
        314
      ],
      "route": "straight"
    },
    {
      "id": "paso-salida",
      "from": "engine_run",
      "to": "mask",
      "label": "salida por paso",
      "classification": "antes de persistir",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "labelAt": [
        315,
        314
      ]
    },
    {
      "id": "estado-row",
      "from": "engine_run",
      "to": "exec_row",
      "label": "estado · duración · error",
      "classification": "misma transacción",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "io-masked",
      "from": "mask",
      "to": "steps_row",
      "label": "IO con ***",
      "classification": "mask aplicado",
      "variant": "security",
      "fromSide": "right",
      "toSide": "left"
    },
    {
      "id": "lectura-consola",
      "from": "steps_row",
      "to": "consola_trace",
      "label": "trace por paso",
      "classification": "GET /executions · /trace",
      "variant": "emphasis",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        638,
        428
      ]
    },
    {
      "id": "replay-read",
      "from": "exec_row",
      "to": "replay",
      "label": "replayOf + versión",
      "classification": "re-ejecutar",
      "variant": "dashed",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        638,
        200
      ]
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Toda ejecución es interpretable",
      "items": [
        "trigger_data registra topic, payload, run_at o el replay original",
        "El registro guarda la versión exacta con la que corrió",
        "El resumen queda consultable un año; el IO, 30 días"
      ]
    },
    {
      "dot": "rose",
      "title": "El secreto muere antes de dormir",
      "items": [
        "El mask congelado por versión aplica *** antes de persistir",
        "El valor original no existe en ninguna tabla del trace",
        "La bóveda audita la versión de credencial de cada ejecución"
      ]
    },
    {
      "dot": "cyan",
      "title": "Consumos del mismo almacén",
      "items": [
        "La consola lee el trace por paso y pinta el rastro por fila",
        "El resumen vive un año aunque el IO se purgue a los 30 días"
      ]
    }
  ]
}