{
  "openapi": "3.1.0",
  "info": {
    "title": "Integraciones API",
    "version": "0.1.0",
    "summary": "Backend de puentes de integración: cadenas de bloques ejecutadas en sandbox JS.",
    "description": "Dos planos:\n\n- **Admin** (`/api/v1`, `Authorization: Bearer <api key>`): biblioteca de bloques,\n  bóveda de credenciales, puentes (borrador + validación + versiones inmutables)\n  y ejecuciones con su traza. Todos los errores son Problem Details (RFC 9457).\n- **Invocación** (`/x/{slug}`, sin auth de administración en v1): ejecución\n  síncrona de un puente publicado con sobre único `{success, data|error, executionId}`.\n\nLos listados del plano admin se paginan por cursor opaco (`limit` + `cursor`).",
    "contact": { "name": "Integraciones" }
  },
  "servers": [
    { "url": "/", "description": "Este servidor (mismo origen: el cliente de la UI resuelve contra el host/puerto con el que abriste /docs)" },
    { "url": "http://localhost:8080", "description": "Desarrollo local (scripts/dev.sh, PORT=8080)" }
  ],
  "tags": [
    { "name": "Admin", "description": "Plano de administración `/api/v1` (Bearer)" },
    { "name": "Invocación", "description": "Plano de invocación `/x` (público en v1)" },
    { "name": "Infra", "description": "Salud e identidad de la sesión" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/healthz": {
      "get": {
        "tags": ["Infra"],
        "summary": "Liveness",
        "description": "Devuelve `ok` en texto plano. No requiere auth.",
        "security": [],
        "responses": {
          "200": { "description": "Servicio vivo", "content": { "text/plain": { "schema": { "type": "string", "example": "ok" } } } }
        }
      }
    },
    "/whoami": {
      "get": {
        "tags": ["Infra"],
        "summary": "Identidad de la API key",
        "description": "Eco de la key autenticada: útil para diagnosticar a qué workspace pertenece.",
        "responses": {
          "200": {
            "description": "Identidad de la key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "name": { "type": "string" },
                    "workspaceId": { "type": "string", "format": "uuid" }
                  },
                  "required": ["id", "name", "workspaceId"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" }
        }
      }
    },
    "/api/v1/blocks": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista bloques de la biblioteca",
        "description": "Paginación por cursor (`created_at, id` descendente). `limit` entre 1 y 100.",
        "parameters": [
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/cursor" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginaBloques" },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Crea un bloque (borrador sin versión)",
        "description": "Los bloques `http` y `custom_logic` built-in ya existen; este endpoint crea bloques con código propio (TypeScript, transpilado a JS al publicar).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBlock" },
              "examples": {
                "custom_logic": {
                  "value": {
                    "slug": "enriquecer-lead",
                    "name": "Enriquecer lead",
                    "blockType": "custom_logic",
                    "category": "crm",
                    "description": "Añade campos calculados al lead",
                    "icon": "sparkles"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Bloque201" },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/api/v1/blocks/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Obtiene un bloque",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "description": "El bloque", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Block" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Elimina un bloque",
        "description": "Fallará con Problem si un puente publicado referencia alguna de sus versiones.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "204": { "description": "Eliminado" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/api/v1/blocks/{id}/versions": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista las versiones publicadas del bloque",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/cursor" }
        ],
        "responses": {
          "200": { "description": "Página de versiones", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaBlockVersion" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Publica una versión inmutable",
        "description": "Transpila el TypeScript a JS con swc, valida `inputSchema`/`ui` y congela el snapshot. Las versiones jamás se modifican.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string", "description": "Código TypeScript del bloque (bloques custom)." },
                  "inputSchema": { "$ref": "#/components/schemas/JsonSchema" },
                  "ui": { "type": "object", "additionalProperties": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Versión publicada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BlockVersion" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/api/v1/credentials": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista metadatos de credenciales",
        "description": "Jamás incluye secretos: solo `id`, `name`, `description` y fechas.",
        "responses": {
          "200": {
            "description": "Metadatos de las credenciales del workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credentials": { "type": "array", "items": { "$ref": "#/components/schemas/Credential" } }
                  },
                  "required": ["credentials"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Crea una credencial",
        "description": "El `secret` es write-only: se cifra en reposo (AES-256-GCM) y nunca se devuelve.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCredential" },
              "examples": { "api-token": { "value": { "name": "crm-token", "secret": "s3cr3t0", "description": "Token del CRM" } } }
            }
          }
        },
        "responses": {
          "201": { "description": "Credencial creada (sin secreto)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credential" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/api/v1/credentials/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Obtiene metadatos de una credencial",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "description": "Metadatos (sin secreto)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credential" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "patch": {
        "tags": ["Admin"],
        "summary": "Rota el secreto o actualiza metadatos",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PatchCredential" }
            }
          }
        },
        "responses": {
          "200": { "description": "Credencial actualizada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credential" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Elimina una credencial",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "204": { "description": "Eliminada" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/api/v1/bridges": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista puentes",
        "parameters": [
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/cursor" }
        ],
        "responses": {
          "200": { "description": "Página de puentes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaBridge" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Crea un puente (borrador)",
        "description": "El borrador agrupa `trigger`, `inputSchema` y `blocks`; se valida al publicar, no al crear la forma.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateBridge" },
              "examples": {
                "webhook-http": {
                  "value": {
                    "slug": "lead-entrante",
                    "name": "Lead entrante",
                    "description": "Webhook del formulario al CRM",
                    "trigger": { "type": "http", "method": "POST" },
                    "blocks": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Bridge201" },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/api/v1/bridges/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Obtiene un puente",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "description": "El puente", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bridge" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "patch": {
        "tags": ["Admin"],
        "summary": "Actualiza el borrador del puente",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateBridge" } } }
        },
        "responses": {
          "200": { "description": "Puente actualizado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bridge" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Elimina un puente",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "204": { "description": "Eliminado" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/api/v1/bridges/{id}/validate": {
      "post": {
        "tags": ["Admin"],
        "summary": "Valida el borrador sin publicar",
        "description": "Devuelve los problemas de forma y de referencias del borrador (bloques inexistentes, schemas no soportados, …) sin gastar versión.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": {
            "description": "Resultado de la validación (issues por campo)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": { "type": "boolean" },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": { "type": "string" },
                          "message": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/api/v1/bridges/{id}/versions": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista las versiones publicadas del puente",
        "parameters": [
          { "$ref": "#/components/parameters/id" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/cursor" }
        ],
        "responses": {
          "200": { "description": "Página de versiones", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaBridgeVersion" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      },
      "post": {
        "tags": ["Admin"],
        "summary": "Publica una versión inmutable del puente",
        "description": "Valida el borrador completo (trigger, instancias, inputSchema) y congela el snapshot `definition`. Si es la primera, `latestVersion` = 1 y el puente queda invocable por slug.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "201": { "description": "Versión publicada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BridgeVersion" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" },
          "409": { "$ref": "#/components/responses/Problem409" }
        }
      }
    },
    "/api/v1/executions": {
      "get": {
        "tags": ["Admin"],
        "summary": "Lista ejecuciones del workspace",
        "parameters": [
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/cursor" }
        ],
        "responses": {
          "200": { "description": "Página de ejecuciones", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaExecution" } } } },
          "400": { "$ref": "#/components/responses/Problem400" },
          "401": { "$ref": "#/components/responses/Problem401" }
        }
      }
    },
    "/api/v1/executions/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Detalle de una ejecución",
        "description": "Incluye el `triggerData`, el estado, fechas y la versión exacta de la definición con la que corrió.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": { "description": "Detalle", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExecutionDetail" } } } },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/api/v1/executions/{id}/trace": {
      "get": {
        "tags": ["Admin"],
        "summary": "Traza paso a paso",
        "description": "Pasos persistidos con la avanzación de estado: entrada/salida por bloque y errores estructurados.",
        "parameters": [{ "$ref": "#/components/parameters/id" }],
        "responses": {
          "200": {
            "description": "Traza de la ejecución",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "steps": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
                  },
                  "required": ["steps"]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Problem401" },
          "404": { "$ref": "#/components/responses/Problem404" }
        }
      }
    },
    "/x/{slug}": {
      "post": {
        "tags": ["Invocación"],
        "summary": "Invoca un puente publicado",
        "description": "Ejecución síncrona de la última versión publicada del puente con ese slug. Cualquier método HTTP es aceptado en el router; el `method` real se valida contra el trigger del puente (405 Problem si no coincide).\n\n- El body (JSON) y la query string llegan al trigger como `{body, query}`.\n- Valida el body contra el `inputSchema` del puente antes de gastar isolate.\n- `Idempotency-Key` opcional: la repetición devuelve el sobre previo sin re-ejecutar.\n- Sobre único 200: `{success: true, data, executionId}` o `{success: false, error, executionId}`.",
        "security": [],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Slug del puente publicado.",
            "schema": { "type": "string" },
            "examples": { "lead": { "value": "lead-entrante" } }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Key de idempotencia: la misma key devuelve el sobre de la corrida original."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JsonSchema" },
              "examples": { "lead": { "value": { "email": "ana@example.com", "nombre": "Ana" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "Sobre de invocación (éxito o fallo estructurado)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvokeEnvelope" } } } },
          "404": { "$ref": "#/components/responses/Problem404" },
          "405": { "description": "El método no coincide con el trigger del puente", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "413": { "description": "Body excede el límite", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
          "415": { "description": "Content-Type no soportado", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key del workspace: `Authorization: Bearer <api key>`."
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Tamaño de página (1..=100).",
        "schema": { "type": "string", "pattern": "^[0-9]+$" },
        "examples": { "veinte": { "value": "20" } }
      },
      "cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Cursor opaco de la página siguiente (tal cual `nextCursor`).",
        "schema": { "type": "string", "maxLength": 256 }
      }
    },
    "responses": {
      "Problem400": { "description": "Cuerpo inválido (Problem Details)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem401": { "description": "Sin o con API key inválida (Problem Details)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem404": { "description": "No existe en el workspace (Problem Details)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Problem409": { "description": "Conflicto: slug duplicado o recurso referenciado (Problem Details)", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } },
      "Bloque201": {
        "description": "Bloque creado",
        "headers": { "Location": { "schema": { "type": "string" }, "description": "URL del recurso creado" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Block" } } }
      },
      "Bridge201": {
        "description": "Puente creado",
        "headers": { "Location": { "schema": { "type": "string" }, "description": "URL del recurso creado" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bridge" } } }
      },
      "PaginaBloques": {
        "description": "Página de bloques",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaBlock" } } }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "Problem Details (RFC 9457). `type` es un slug corto (`not-found`, `unauthorized`, `internal`, …) y los miembros extra son extensiones.",
        "properties": {
          "type": { "type": "string", "description": "Slug del tipo de problema, p. ej. `not-found`." },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        },
        "required": ["type", "title", "status"]
      },
      "JsonSchema": {
        "type": "object",
        "description": "JSON Schema (subconjunto soportado por el validador del workspace).",
        "additionalProperties": true
      },
      "CreateBlock": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string", "maxLength": 200 },
          "blockType": { "type": "string", "enum": ["custom_logic"], "description": "Los built-in `http`/`custom_logic` ya existen; aquí se crean bloques con código propio." },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" }
        },
        "required": ["slug", "name", "blockType"]
      },
      "Block": {
        "type": "object",
        "description": "Fila de la biblioteca de bloques.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspaceId": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "blockType": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "latestVersion": { "type": ["integer", "null"], "description": "Última versión publicada (null = sin versiones)." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "workspaceId", "slug", "name", "blockType", "category", "description", "icon", "createdAt", "updatedAt"]
      },
      "BlockVersion": {
        "type": "object",
        "description": "Versión inmutable de un bloque. `code` es el JS transpilado (null solo en bloques built-in históricos).",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "blockId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer" },
          "code": { "type": ["string", "null"] },
          "inputSchema": { "$ref": "#/components/schemas/JsonSchema" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "blockId", "version"]
      },
      "CreateCredential": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "secret": { "type": "string", "writeOnly": true, "description": "Secreto en claro: se cifra en reposo y jamás se devuelve." },
          "description": { "type": "string" }
        },
        "required": ["name", "secret"]
      },
      "PatchCredential": {
        "type": "object",
        "description": "Al menos un campo (`secret`, `name` o `description`).",
        "properties": {
          "secret": { "type": "string", "writeOnly": true, "description": "Nuevo valor (rotación)." },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "minProperties": 1
        }
      },
      "Credential": {
        "type": "object",
        "description": "Metadatos de una credencial: jamás incluye el secreto.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "description", "createdAt", "updatedAt"]
      },
      "CreateBridge": {
        "type": "object",
        "description": "Borrador de puente: `trigger` + `blocks` + `inputSchema` opcional. La validación fuerte ocurre al publicar.",
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "trigger": {
            "type": "object",
            "description": "Disparo del puente; en MVP1 `http` con `method` opcional (default GET).",
            "properties": {
              "type": { "type": "string", "enum": ["http"] },
              "method": { "type": "string", "description": "Método HTTP aceptado (default GET)." }
            }
          },
          "inputSchema": { "$ref": "#/components/schemas/JsonSchema" },
          "blocks": {
            "type": "array",
            "description": "Instancias de bloques encadenados.",
            "items": { "type": "object", "additionalProperties": true }
          }
        },
        "required": ["slug", "name", "description", "trigger", "blocks"]
      },
      "Bridge": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "latestVersion": { "type": ["integer", "null"], "description": "Versión publicada invocable (null = sin publicar)." },
          "draft": { "type": ["object", "null"], "additionalProperties": true, "description": "Borrador actual (trigger + blocks + inputSchema)." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "slug", "name", "description", "createdAt", "updatedAt"]
      },
      "BridgeVersion": {
        "type": "object",
        "description": "Versión publicada inmutable; el snapshot completo vive en `definition`.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "bridgeId": { "type": "string", "format": "uuid" },
          "version": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "bridgeId", "version"]
      },
      "Execution": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "bridgeId": { "type": "string", "format": "uuid" },
          "bridgeVersionId": { "type": "string", "format": "uuid" },
          "triggerType": { "type": "string" },
          "status": { "type": "string", "description": "`pending`, `success`, `failed`, …" },
          "error": { "type": ["object", "null"], "$ref": "#/components/schemas/InvokeError" },
          "startedAt": { "type": ["string", "null"], "format": "date-time" },
          "finishedAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "bridgeId", "bridgeVersionId", "triggerType", "status", "createdAt"]
      },
      "ExecutionDetail": {
        "type": "object",
        "description": "Detalle completo: añade `triggerData` y `definition` (snapshot exacto con el que corrió).",
        "allOf": [
          { "$ref": "#/components/schemas/Execution" },
          {
            "type": "object",
            "properties": {
              "triggerData": { "type": "object", "additionalProperties": true },
              "definition": { "type": "object", "additionalProperties": true }
            }
          }
        ]
      },
      "InvokeError": {
        "type": "object",
        "description": "Error estructurado de una ejecución.",
        "properties": {
          "code": { "type": "string", "enum": ["VALIDATION_FAILED", "BLOCK_FAILED", "TIMEOUT", "REF_UNRESOLVED"] },
          "message": { "type": "string" },
          "block": { "type": "string", "description": "Instancia de bloque donde ocurrió, si aplica." },
          "details": { "type": "object", "additionalProperties": true }
        },
        "required": ["code", "message"]
      },
      "InvokeEnvelope": {
        "type": "object",
        "description": "Sobre único de invocación (`/x/{slug}`): éxito con `data` o fallo estructurado con `error`. Siempre incluye `executionId`.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "success": { "const": true },
              "data": { "description": "Salida del último bloque (o null)." },
              "executionId": { "type": "string", "format": "uuid" }
            },
            "required": ["success", "data", "executionId"]
          },
          {
            "type": "object",
            "properties": {
              "success": { "const": false },
              "error": { "$ref": "#/components/schemas/InvokeError" },
              "executionId": { "type": "string", "format": "uuid" }
            },
            "required": ["success", "error", "executionId"]
          }
        ]
      },
      "PaginaBlock": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Block" } },
          "nextCursor": { "type": ["string", "null"], "description": "Cursor opaco para la siguiente página (null en la última)." }
        },
        "required": ["items", "nextCursor"]
      },
      "PaginaBlockVersion": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/BlockVersion" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"]
      },
      "PaginaBridge": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Bridge" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"]
      },
      "PaginaBridgeVersion": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/BridgeVersion" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"]
      },
      "PaginaExecution": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Execution" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"]
      }
    }
  }
}
